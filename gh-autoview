#!/usr/bin/env bash
# gh-autoview (fork of OperatorJack/gh-autoview) — mark boring PR files as
# "Viewed" on GitHub so the review UI collapses them and only files a human
# needs to read stay in your review queue.
#
# Which files are "boring" comes from a per-repo pattern file written in
# .gitignore syntax, matched with `git check-ignore`.
#
# Usage: gh autoview [PR] [options]        (or: gh-autoview ...)
#
#   PR                 PR number, URL, or branch. Default: PR for current branch.
#   -a, --apply        Actually change viewed state. Without it: a dry run.
#   -n, --dry-run      Explicit dry run; this is already the default.
#   -l, --list         Show every PR file with its viewed state and match.
#   -u, --unmark       Un-view matching files instead (undo). Needs --apply.
#   -c, --config FILE  Pattern file (default: lookup order below).
#   -R, --repo O/R     Repo to use (default: derived from current directory).
#   -h, --help
#
# Pattern lookup: --config FILE, then <root>/.autoview, <root>/.github/autoview,
# ~/.config/gh-autoview/<owner>-<repo>, ~/.config/gh-autoview/default, then the
# built-in policy: everything that is not hand-written Swift, plus generated
# Swift (*.g.swift) and unit tests (*Test.swift, *Tests.swift). A config file
# replaces the built-in policy; negation works in all of them.
set -euo pipefail

die()  { printf 'gh-autoview: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

PR="" APPLY=0 LIST=0 UNMARK=0 CONFIG="" REPO=""
while (($#)); do
  case "$1" in
    -a|--apply)   APPLY=1 ;;
    -n|--dry-run) APPLY=0 ;;
    -l|--list)    LIST=1 ;;
    -u|--unmark)  UNMARK=1 ;;
    -c|--config)  CONFIG="${2:?--config needs a file}"; shift ;;
    -R|--repo)    REPO="${2:?--repo needs OWNER/REPO}"; shift ;;
    -h|--help)    usage; exit 0 ;;
    -*)           die "unknown option: $1 (try --help)" ;;
    *)            [[ -z "$PR" ]] || die "unexpected argument: $1"; PR="$1" ;;
  esac
  shift
done

command -v gh  >/dev/null || die "gh not found"
command -v jq  >/dev/null || die "jq not found"
command -v git >/dev/null || die "git not found"

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

# ---- resolve repo + PR ---------------------------------------------------
repoargs=()
[[ -n "$REPO" ]] && repoargs=(-R "$REPO")
prjson="$(gh pr view ${PR:+"$PR"} "${repoargs[@]}" --json number,url 2>/dev/null)" \
  || die "could not resolve PR${PR:+ '$PR'} (are you on a branch with an open PR? try: gh autoview <number>)"
prnum="$(jq -r .number <<<"$prjson")"
prurl="$(jq -r .url <<<"$prjson")"
owner="$(sed -E 's#https://[^/]+/([^/]+)/([^/]+)/pull/.*#\1#' <<<"$prurl")"
name="$(sed -E 's#https://[^/]+/([^/]+)/([^/]+)/pull/.*#\2#' <<<"$prurl")"

# Apollo operation documents live under Sources/Codegen/ next to the Swift they
# generate. Nothing in the filename says "generated" (they are not *.g.*), so
# the path is the only reliable signal. Only applied when no config file exists.
# Default policy: every file, minus the Swift you actually wrote. Generated
# Swift (*.g.swift) and unit tests (*Test.swift, *Tests.swift) come back in.
# Last matching pattern wins, so the order below is the policy. The '!**/'
# line keeps directories out of the ignore set -- without it git refuses to
# re-include any file under a directory matched by '**/*'.
DEFAULT_PATTERNS=(
  '**/*'
  '!**/'
  '!**/*.swift'
  '**/*.g.swift'
  '**/*Test.swift'
  '**/*Tests.swift'
)

# ---- locate patterns ----------------------------------------------------
if [[ -n "$CONFIG" ]]; then
  [[ -f "$CONFIG" ]] || die "no such config file: $CONFIG"
  source_desc="--config $CONFIG"
else
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  config=""
  for cand in "${root:+$root/.autoview}" "${root:+$root/.github/autoview}" \
              "${XDG_CONFIG_HOME:-$HOME/.config}/gh-autoview/$owner-$name" \
              "${XDG_CONFIG_HOME:-$HOME/.config}/gh-autoview/default"; do
    [[ -n "$cand" && -f "$cand" ]] && { config="$cand"; break; }
  done
  if [[ -n "$config" ]]; then
    source_desc="$config"
  else
    config="$tmp/defaults.autoview"
    printf '%s\n' "${DEFAULT_PATTERNS[@]}" > "$config"
    source_desc="built-in policy (all non-Swift + generated Swift + unit tests)"
  fi
fi
grep -qv -E '^[[:space:]]*(#|$)' "$config" || die "$source_desc has no patterns"

# ---- fetch PR node id + all files with their viewed state ---------------
QUERY='query($o:String!,$r:String!,$n:Int!,$c:String){
  repository(owner:$o,name:$r){ pullRequest(number:$n){ id
    files(first:100,after:$c){ nodes{ path viewerViewedState } pageInfo{ hasNextPage endCursor } } } } }'

PRID=""
load_files() {
  local cursor=null page
  FILES='[]'
  while :; do
    page="$(gh api graphql -f query="$QUERY" -F o="$owner" -F r="$name" -F n="$prnum" -F c="$cursor")" \
      || die "GraphQL query failed"
    PRID="$(jq -r .data.repository.pullRequest.id <<<"$page")"
    FILES="$(jq -c --argjson acc "$FILES" '$acc + .data.repository.pullRequest.files.nodes' <<<"$page")"
    jq -e .data.repository.pullRequest.files.pageInfo.hasNextPage <<<"$page" >/dev/null || break
    cursor="$(jq -r .data.repository.pullRequest.files.pageInfo.endCursor <<<"$page")"
  done
  [[ -n "$PRID" && "$PRID" != null ]] || die "PR #$prnum has no node id?"
}

load_files

# ---- match paths against the patterns using real gitignore semantics -----
git init -q "$tmp/r"
# core.ignoreCase=false: on macOS git defaults to case-insensitive matching,
# which makes '*.Test.swift' swallow names like 'IntegrateLatest.swift'.
matched="$(jq -r '.[].path' <<<"$FILES" \
  | git -C "$tmp/r" -c core.excludesFile="$config" -c core.ignoreCase=false \
      check-ignore --no-index --stdin 2>/dev/null || true)"
matched_json="$(printf '%s\n' "$matched" | jq -R -s 'split("\n") | map(select(length>0))')"
ann="$(jq -c --argjson m "$matched_json" 'map(. + {match: (.path as $p | $m | index($p) != null)})' <<<"$FILES")"

if ((LIST)); then
  jq -r '.[] | [(if .match then "MATCH" else "-" end), .viewerViewedState, .path] | @tsv' <<<"$ann" | column -t -s $'\t'
  exit 0
fi

if ((UNMARK)); then
  targets="$(jq -c '[.[] | select(.match and .viewerViewedState == "VIEWED") | .path]' <<<"$ann")"
  mutation=unmarkFileAsViewed verb="un-view" done_verb="un-viewed" want=UNVIEWED
else
  targets="$(jq -c '[.[] | select(.match and .viewerViewedState != "VIEWED") | .path]' <<<"$ann")"
  mutation=markFileAsViewed verb="mark viewed" done_verb="marked viewed" want=VIEWED
fi

total="$(jq length <<<"$FILES")"; nmatch="$(jq '[.[]|select(.match)]|length' <<<"$ann")"; ntarget="$(jq length <<<"$targets")"
info "PR #$prnum ($owner/$name): $total files, $nmatch match $source_desc, $ntarget to $verb"
if ((ntarget == 0)); then exit 0; fi
jq -r '.[] | "  " + .' <<<"$targets" >&2
if ((APPLY == 0)); then info "(dry run — nothing changed; add --apply to $verb)"; exit 0; fi

# ---- batch mutations: many aliased calls per request ---------------------
batch=25
for ((i=0; i<ntarget; i+=batch)); do
  chunk="$(jq -c ".[$i:$((i+batch))]" <<<"$targets")"
  body="$(jq -r --arg m "$mutation" 'to_entries | map("f\(.key): \($m)(input:{pullRequestId:$id, path:\(.value|tojson)}){ clientMutationId }") | join("\n")' <<<"$chunk")"
  gh api graphql -f query="mutation(\$id:ID!){ $body }" -F id="$PRID" >/dev/null \
    || die "mutation failed on batch starting at item $i"
done

# ---- confirm the server agrees ------------------------------------------
load_files
confirm="$(jq -c --argjson t "$targets" --arg w "$want" \
  '[.[] | select(.path as $p | $t | index($p) != null)]
   | { ok: (map(select(.viewerViewedState == $w)) | length), checked: length }' <<<"$FILES")"
info "done: $ntarget file(s) $done_verb on $prurl/files"
info "verified: $(jq -r .ok <<<"$confirm")/$(jq -r .checked <<<"$confirm") now $want"
[[ "$(jq -r .ok <<<"$confirm")" == "$(jq -r .checked <<<"$confirm")" ]] || die "some files did not reach $want"
